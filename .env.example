# Lantern — Environment Variables
# Copy this file to .env.local for local development.
# Set these in your Vercel project settings for production.

# Optional: Plausible Analytics domain
# Set to your domain (e.g. lantern.yoursite.com) to enable privacy-respecting analytics.
# Leave unset to disable all tracking.
VITE_PLAUSIBLE_DOMAIN=

# Optional: Feedback form URL
# Shown as a "Send Feedback" link in Settings when set.
# Can be a Tally form, Google Form, Notion page, or any URL.
VITE_FEEDBACK_URL=
